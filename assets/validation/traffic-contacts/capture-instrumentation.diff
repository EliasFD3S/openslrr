+void validation_dump_bench_ground_topology() {
+  const auto* root = gameref_get(g_world);
+  std::fprintf(stderr, "[validation-world] world=%p children=%zu cache-types=%zu\n", g_world, root ? root->children.size() : 0, g_ground_props.size());
+  unsigned keys = 0;
+  for (const auto& entry : g_ground_props) {
+    if (keys++ >= 16) break;
+    std::fprintf(stderr, "[validation-cache] type=0x%x\n", entry.first);
+  }
+  unsigned visited = 0, printed = 0, matches = 0;
+  const auto visit = [&](auto&& self, void* key, unsigned depth) -> void {
+    const auto* node = gameref_get(key);
+    if (!node || visited++ >= 2048) return;
+    const bool cached = g_ground_props.contains(static_cast<uint32_t>(node->type_id));
+    if (cached) ++matches;
+    if ((depth <= 1 || cached) && printed++ < 80)
+      std::fprintf(stderr, "[validation-node] depth=%u key=%p parent=%p kind=%d type=0x%x flags=0x%x empty=%d children=%zu cached=%d\n", depth, key, node->parent, int(node->kind), unsigned(node->type_id), unsigned(node->flags), int(node->empty), node->children.size(), int(cached));
+    if (depth < 4)
+      for (void* child : node->children) self(self, child, depth + 1);
+  };
+  visit(visit, g_world, 0);
+  std::fprintf(stderr, "[validation-world] visited=%u cache-matches-in-subtree=%u\n", visited, matches);
+  std::fflush(stderr);
+}
